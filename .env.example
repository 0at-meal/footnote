# Footnote Environment Variables
GROQ_API_KEY=your_groq_api_key_here

# Contact for SEC EDGAR requests (required for EDGAR features): "Your Name you@example.com"
# SEC_USER_AGENT=

# Public origin written into workbook deep links (default http://localhost:8000)
# PUBLIC_BASE_URL=

# Data directory for jobs/uploads/results (default backend/data). Point experiments at a copy.
# FOOTNOTE_DATA_DIR=

# Degraded mode: allow the PyMuPDF fallback when Docling is missing (default: refuse to start)
# ALLOW_PYMUPDF_FALLBACK=1

# Seconds a job may stay 'extracting' before it is failed with a reason (default 1800)
# JOB_TIMEOUT_SECONDS=1800
